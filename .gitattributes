# Normalize line endings; Windows tooling files stay CRLF, text formats stay LF.
* text=auto
*.cs text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.sln text eol=crlf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
